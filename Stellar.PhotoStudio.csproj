<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.PhotoStudio</RootNamespace>
    <AssemblyName>Stellar.PhotoStudio</AssemblyName>
    <Version>1.4.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Photo Studio 1.4.0 (hide me + effects layers) needs framework 2.16.0 — built here against the local dev
         package 2.16.0-hide-dev until the framework release flips this to 2.16.0 (dev-workflow.md § unreleased members). -->
    <PackageReference Include="Stellar.Abstractions" Version="2.16.0-hide-dev" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.PhotoStudio.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json" LogicalName="Stellar.PhotoStudio.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json" LogicalName="Stellar.PhotoStudio.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json" LogicalName="Stellar.PhotoStudio.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.PhotoStudio.Lang.fil.json" />
    <!-- Launcher-tile icon (camera + sparkles, owner-supplied 2026-10-01). -->
    <EmbeddedResource Include="Resources/photostudio-icon.png" LogicalName="Stellar.PhotoStudio.photostudio-icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Stellar.PhotoStudio.Tests" />
  </ItemGroup>
</Project>
